{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types"
    ],
    "types": [
      "node",
      "multer"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.test.ts",
    "../shared/**/*.test.ts",
    "../shared/tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
