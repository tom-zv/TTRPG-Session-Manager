{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"],
    "types": ["node", "multer"],
    "paths": {
      "shared/*": ["../shared/*"],
      "src/*": ["./src/*"],
      "client/*": ["../client/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
