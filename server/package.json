{
  "name": "ttrpg-session-manager-server",
  "version": "1.0.0",
  "description": "backend server for TTRPG Session Manager",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/server/src/index.js",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "import:dnd5etools": "tsx src/scripts/import-dnd5etools-entities.ts",
    "build": "tsc && tsc-alias",
    "watch": "tsc -w",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3",
    "mysql2": "^3.22.3",
    "mysqldump": "^3.2.0",
    "socket.io": "^4.8.3",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "2.1.0",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "p-limit": "^7.3.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
